{
  "name": "opencart-regresion-santiago",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pruebas de regresión, API, rendimiento y seguridad de OpenCart (RF-06 a RF-11) con Vitest",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node ejecutar.mjs",
    "test:funcional": "vitest run regression-testing",
    "test:api": "vitest run api-testing",
    "test:performance": "vitest run performance-testing",
    "test:seguridad": "vitest run security-testing"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "chai": "^5.3.3",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
