# ─────────────────────────────────────────────────────────────────────────────
# Agente de Jenkins para OpenCart (mismo patrón que el de CelularPro)
#
# Jenkins construye esta imagen y corre cada etapa del pipeline dentro de ella
# (agent { dockerfile ... } en el Jenkinsfile). La máquina de Jenkins solo
# necesita Docker: Node, PHP, Composer, pcov y el cliente de Docker vienen aquí.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim

# PHP para PHPUnit (con pcov para la cobertura que lee SonarQube), git y curl.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl unzip \
        php-cli php-mbstring php-xml php-curl php-mysql php-zip php-pcov \
    && rm -rf /var/lib/apt/lists/*

# Composer y cliente de Docker (con compose) copiados de las imágenes oficiales.
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
